<body>
    <iframe id="gasFrame" style="width: 100%; height: 100vh;" scrolling="yes" frameborder="0"></iframe>
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const page = urlParams.get('page');
        const baseUrl = "https://script.google.com/macros/s/AKfycbzczQ287Pe60w5M_s20suSpwNsnvjF6FRGsQuVgy4naQBzrxVlevGeOrMIIHwZ63OqS/exec";
        
        if (page) {
            document.getElementById('gasFrame').src = baseUrl + "?page=" + page;
        } else {
            document.getElementById('gasFrame').src = baseUrl;
        }
    </script>
</body>
</html>
